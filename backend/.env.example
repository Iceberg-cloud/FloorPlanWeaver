LLM_PROVIDER=openai
LLM_API_BASE=https://llmapi.paratera.com/v1
LLM_API_KEY=
LLM_MOCK_MODE=false

PLANNER_USE_LLM=true
DRAWER_USE_LLM=true
DRAWER_FALLBACK_TO_RULE=true
DEFAULT_DRAW_MODE=layout

PLANNER_MODEL=DeepSeek-V4-Flash
DRAWER_MODEL=Doubao-Seedream-5.0-lite
LAYOUT_MODEL=
# 规划师/布局单次 HTTP 等待（秒），不得超过 LLM_HARD_TIMEOUT_SECONDS
LAYOUT_TIMEOUT_SECONDS=120
LAYOUT_LLM_MAX_RETRIES=2
LAYOUT_USE_GRID_COMPILER=true

# 规划师对话 LLM 等待上限（秒）
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
# 单次调用+重试总耗时的硬上限（秒），Windows 下 urllib 仅支持单一 timeout
LLM_HARD_TIMEOUT_SECONDS=120

# P0 会话记忆：sqlite 持久化（重启不丢）；测试自动用 memory
SESSION_STORE=sqlite
SESSION_DB_PATH=backend/data/sessions.db
PLANNER_MAX_HISTORY_TURNS=8
# 规划师最多追问轮数（1=最多追问1次后强制出方案出图；可设为2）
PLANNER_MAX_ASK_ROUNDS=1
